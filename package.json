{
  "name": "my-little-agent",
  "version": "0.2.0",
  "description": "Chrome Built-in AI 기반 멀티 에이전트 라이브러리",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Hayoung Kang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hayoung0708/my-little-agent.git"
  },
  "homepage": "https://github.com/Hayoung0708/my-little-agent#readme",
  "bugs": {
    "url": "https://github.com/Hayoung0708/my-little-agent/issues"
  },
  "keywords": [
    "chrome",
    "built-in-ai",
    "prompt-api",
    "gemini-nano",
    "agent",
    "multi-agent",
    "tool-calling",
    "on-device-ai",
    "translator-api",
    "summarizer-api"
  ],
  "files": [
    "dist",
    "src",
    "README-en_us.md"
  ],
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && publint --strict",
    "example": "vite example",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "vitest run --typecheck.only",
    "test:package": "node scripts/test-package.mjs",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && pnpm test:types && pnpm test:package",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/size.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "only-allow pnpm && husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@playwright/test": "^1.49.0",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/vite-config": "^0.4.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "only-allow": "^1.2.1",
    "prettier": "^3.4.2",
    "publint": "^0.3.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  }
}
